        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30">
                <item android:color="#2DF59E0B" android:offset="0.0" />
                <item android:color="#0DF59E0B" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Monogram Prism - Drop Shadow Base -->
    <group
