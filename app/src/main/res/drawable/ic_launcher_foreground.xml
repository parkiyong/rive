    <!-- Monogram Prism - Vertical Stem -->
    <path
        android:pathData="M37.5,30 L40,30 C42,30 43.5,31.5 43.5,33.5 L43.5,74.5 C43.5,76.5 42,78 40,78 L37.5,78 C35.5,78 34,76.5 34,74.5 L34,33.5 C34,31.5 35.5,30 37.5,30 Z">
