                android:endX="43.5"
                android:endY="78">
                <item android:color="#FDE68A" android:offset="0.0" />
                <item android:color="#F59E0B" android:offset="0.4" />
                <item android:color="#B45309" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Monogram Prism - Upper Bowl -->
    <path
        android:fillType="evenOdd"
        android:pathData="M41,30 L57,30 C64.5,30 70.5,35.5 70.5,42.5 C70.5,49.5 64.5,55 57,55 L41,55 Z M43.5,38 L56,38 C60.5,38 63,40 63,42.5 C63,45 60.5,47 56,47 L43.5,47 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="41"
                android:startY="30"
                android:endX="70.5"
                android:endY="55">
